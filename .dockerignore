*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/

# Runtime state and large local assets.
*.log
*.pid
memory_service.pid
agent_gateway.pid
distill_worker.pid
portal-ui.pid
.runtime/
models/
data/
tmp/

# The portal has its own Docker build context.
portal-ui/

# OS/editor noise.
.DS_Store
