#+#+#+#+############################################################
# Example env file for LLM-based context planner (OpenAI-like)
#
# This planner is OPTIONAL. When enabled, the agent asks a cheaper LLM to
# decide what memories to retrieve (STM/semantic/prefs/WM) to reduce
# token waste and improve recall.
#
# IMPORTANT: Do NOT commit real secrets. Copy to `config/context_planner.env`.
########################################################################

CONTEXT_PLANNER_ENABLED=1
CONTEXT_PLANNER_PROVIDER=openai-like

# OpenAI-compatible endpoint (example: ModelScope)
CONTEXT_PLANNER_OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
CONTEXT_PLANNER_OPENAI_API_KEY=__REPLACE_WITH_YOUR_TOKEN__

# Model for planning (cheap is fine)
CONTEXT_PLANNER_MODEL=ZhipuAI/GLM-4.7-Flash

# Optional tuning
CONTEXT_PLANNER_TEMPERATURE=0.1
CONTEXT_PLANNER_MAX_OUTPUT_TOKENS=600

# Optional retry tuning (rate limit 429)
# CONTEXT_PLANNER_MAX_ATTEMPTS=6
# CONTEXT_PLANNER_RETRY_BASE_SLEEP_S=0.5
