# Example env file for async memory distillation worker (OpenAI-like provider)
#
# IMPORTANT: Do NOT commit real secrets. Copy to `config/distill_worker.env` and
# edit locally.

# Enable distillation and select provider.
MEMORY_DISTILL_ENABLED=1
MEMORY_DISTILL_PROVIDER=openai-like

# ModelScope OpenAI-compatible endpoint.
MEMORY_DISTILL_OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1

# Token (ModelScope). Prefer setting this in your shell / secret manager.
MEMORY_DISTILL_OPENAI_API_KEY=__REPLACE_WITH_YOUR_TOKEN__

# Model id.
MEMORY_DISTILL_MODEL=ZhipuAI/GLM-4.7-Flash

# Optional tuning.
MEMORY_DISTILL_TEMPERATURE=0.2
MEMORY_DISTILL_MAX_OUTPUT_TOKENS=900

# Optional retry tuning for 429 rate limits.
# MEMORY_DISTILL_MAX_ATTEMPTS=8
# MEMORY_DISTILL_RETRY_BASE_SLEEP_S=0.8

# Redis queue (worker reads these; gateway enqueues jobs there).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional overrides.
# MEMORY_DISTILL_QUEUE_KEY=am:distill:queue
# MEMORY_DISTILL_DEDUPE_SET_KEY=am:distill:dedupe
