# Example env file for main reasoning LLM (OpenAI-compatible)
#
# This is the primary LLM used by agents / gateway.
# For Azure OpenAI OpenAI-compatible endpoints, use the OpenAI client with:
#   OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
#   OPENAI_MODEL=<deployment_name>
# and set AZURE_OPENAI_API_VERSION if required by your endpoint.
#
# IMPORTANT: Do NOT commit real secrets. Copy to `config/openai_main.env` and
# edit locally.

OPENAI_BASE_URL=https://root123.openai.azure.com/openai/v1/
OPENAI_API_KEY=__REPLACE_WITH_YOUR_AZURE_OPENAI_KEY__

# For Azure OpenAI OpenAI-compatible: set this to deployment name.
OPENAI_MODEL=gpt-5.2-chat

# Some Azure OpenAI endpoints require api-version as a query parameter.
# Use whatever your resource expects.
AZURE_OPENAI_API_VERSION=preview

# Optional: default provider selection for the framework resolver.
LLM_PROVIDER=openai-like

