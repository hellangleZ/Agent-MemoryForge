# .env.template
# 环境变量配置模板
# 请复制此文件为 .env 并填入您的真实配置

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT="your-azure-openai-endpoint-here"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name-here"
AZURE_OPENAI_API_KEY="your-api-key-here"

# Alternative: Traditional OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key_here"

# Neo4j Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password-here"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Memory safety defaults
# Automatic preference persistence is evidence-gated by default. Set to "1" only
# if this deployment wants a manual confirmation step for preference writes.
PREFERENCE_REQUIRE_CONFIRMATION="0"

# Portal UI
# Keep internal MCP/tool traces hidden from ordinary chat. Set to "1" only when
# debugging agent tool routing in the portal.
NEXT_PUBLIC_SHOW_TOOL_TRACE="0"

# Portal authentication
# Use at least 32 random bytes. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
