####################################################################
# Agent-MemoryForge — Full config example
#
# Copy to `.env` and fill placeholders.
# This file is intentionally verbose: it enumerates supported env vars and
# marks typically-required vs optional knobs.
#
# Security: never commit real secrets.
####################################################################

############################
# LLM Provider (choose one)
############################

# REQUIRED for any LLM calls.
# Options: "azure" | "openai-like"
LLM_PROVIDER="azure"

############################
# Azure OpenAI (if LLM_PROVIDER=azure)
############################

AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<azure_openai_api_key>"
AZURE_OPENAI_DEPLOYMENT="<deployment_name>"

# Optional: only needed for Azure *non-openai/v1* endpoints.
# If you use an OpenAI-compatible base URL (*/openai/v1/*), leave this empty.
AZURE_OPENAI_API_VERSION=""

# OPTIONAL (alias used by some code paths)
AZURE_OPENAI_MODEL=""

############################
# OpenAI-like (if LLM_PROVIDER=openai-like)
############################

OPENAI_API_KEY="<openai_api_key>"

# OPTIONAL (defaults exist in code)
OPENAI_MODEL="gpt-4o-mini"

# OPTIONAL (set for proxies/self-hosted endpoints)
OPENAI_BASE_URL=""

# OPTIONAL: "auto" prefers Responses API and falls back to Chat Completions
# when the provider clearly does not support Responses. Use "chat" for
# OpenAI-compatible providers that only expose /chat/completions.
OPENAI_API_STYLE="auto"  # auto | responses | chat

############################
# Memory Distill (OPTIONAL)
############################

# If set, memory distillation uses these; otherwise falls back to OPENAI_*/AZURE_OPENAI_*.

# Optional toggles/tuning
MEMORY_DISTILL_ENABLED="1"
MEMORY_DISTILL_PROVIDER=""  # empty means fall back to LLM_PROVIDER
MEMORY_DISTILL_MODEL=""  # empty means fall back to OPENAI_MODEL/AZURE_OPENAI_DEPLOYMENT
MEMORY_DISTILL_EVERY_N_ROUNDS="1"
MEMORY_DISTILL_TEMPERATURE="0.2"
MEMORY_DISTILL_MAX_OUTPUT_TOKENS="800"
MEMORY_DISTILL_LLM_MAX_ATTEMPTS="8"
MEMORY_DISTILL_RETRY_BASE_SLEEP_S="0.8"
MEMORY_DISTILL_TIMEOUT_S="45"

# Redis queue tuning (optional)
MEMORY_DISTILL_QUEUE_KEY="am:distill:queue"
MEMORY_DISTILL_DEDUPE_SET_KEY="am:distill:dedupe"
MEMORY_DISTILL_DEDUPE_TTL_S="604800"
MEMORY_DISTILL_JOB_RESULT_PREFIX="am:distill:job:"
MEMORY_DISTILL_JOB_RESULT_TTL_S="604800"
MEMORY_DISTILL_MAX_ATTEMPTS="5"

MEMORY_DISTILL_OPENAI_API_KEY=""
MEMORY_DISTILL_OPENAI_BASE_URL=""
MEMORY_DISTILL_OPENAI_API_STYLE=""  # empty means OPENAI_API_STYLE/auto
MEMORY_DISTILL_STORE_PREFERENCES="1"
MEMORY_DISTILL_PREFERENCE_REQUIRE_CONFIRMATION="0"
MEMORY_DISTILL_PREFERENCE_MIN_CONFIDENCE="0.8"
MEMORY_DISTILL_AZURE_OPENAI_API_KEY=""
MEMORY_DISTILL_AZURE_OPENAI_ENDPOINT=""
MEMORY_DISTILL_AZURE_OPENAI_DEPLOYMENT=""
MEMORY_DISTILL_AZURE_OPENAI_API_VERSION=""

############################
# Context Planner (OPTIONAL)
############################

CONTEXT_PLANNER_ENABLED="0"
CONTEXT_PLANNER_PROVIDER="openai-like"  # openai-like | azure
CONTEXT_PLANNER_MODEL="gpt-4o-mini"
CONTEXT_PLANNER_TEMPERATURE="0.1"
CONTEXT_PLANNER_MAX_OUTPUT_TOKENS="600"
CONTEXT_PLANNER_MAX_ATTEMPTS="6"
CONTEXT_PLANNER_RETRY_BASE_SLEEP_S="0.5"

CONTEXT_PLANNER_OPENAI_API_KEY=""
CONTEXT_PLANNER_OPENAI_BASE_URL=""
CONTEXT_PLANNER_OPENAI_API_STYLE=""  # empty means OPENAI_API_STYLE/auto
CONTEXT_PLANNER_AZURE_OPENAI_API_KEY=""
CONTEXT_PLANNER_AZURE_OPENAI_ENDPOINT=""
CONTEXT_PLANNER_AZURE_OPENAI_DEPLOYMENT=""
CONTEXT_PLANNER_AZURE_OPENAI_API_VERSION=""

############################
# Service URLs / Identity
############################

# Memory service base URL used by demos + SDK factory.
MEMORY_SERVICE_URL="http://127.0.0.1:8001"

# Internal key used by gateway/worker/SDK when calling Memory Service.
# Generate a random value for each deployment.
AGENT_MEMORY_SERVICE_API_KEY="<random_internal_memory_service_key>"

# Local-only escape hatch. Keep 0 in production; without a service key the
# Memory Service rejects requests unless this is set in non-production.
AGENT_MEMORY_SERVICE_ALLOW_UNAUTHENTICATED_LOCAL_DEV="0"

# Embedding service default URL (if provider=local)
EMBEDDING_SERVICE_URL="http://127.0.0.1:7999/v1/embeddings"

# Used by examples + some SDK factory defaults
USER_ID="project_manager_alice"
AGENT_ID="agent_project_management_assistant"

# OPTIONAL: host/port style config (used by pydantic settings)
MEMORY_SERVICE_HOST="127.0.0.1"
MEMORY_SERVICE_PORT="8001"
MEMORY_SERVICE_TIMEOUT="15"

############################
# Redis
############################

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"

# OPTIONAL
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS="10"

############################
# Postgres / pgvector (recommended for enterprise vector search)
############################

POSTGRES_DB="agent_memory"
POSTGRES_USER="agent_memory"
POSTGRES_PASSWORD="<postgres_password>"

# Used by the file-first memory service when AGENT_MEMORY_VECTOR_BACKEND=pgvector.
AGENT_MEMORY_PGVECTOR_DSN="postgresql://agent_memory:<postgres_password>@localhost:5432/agent_memory"
AGENT_MEMORY_PGVECTOR_TABLE="agent_memory_vectors"
AGENT_MEMORY_PGVECTOR_DIM="1536"

############################
# Neo4j
############################

NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="<neo4j_password>"

# OPTIONAL
NEO4J_DATABASE="neo4j"

############################
# Memory indexing / embedding settings
############################

EMBEDDING_MODEL_NAME="qwen3-embedding-0___6b"

# OPTIONAL tuning (used by pydantic settings)
EMBEDDING_DIMENSION="1024"
EMBEDDING_TIMEOUT="30"
EMBEDDING_BATCH_SIZE="10"

############################
# Embeddings (choose one)
############################

# local | azure
EMBEDDING_PROVIDER="local"

# Azure embedding (OpenAI-compatible): base_url should end with /openai/v1/
AZURE_EMBEDDING_BASE_URL="https://<resource>.cognitiveservices.azure.com/openai/v1/"
AZURE_EMBEDDING_API_KEY="<azure_embedding_api_key>"
AZURE_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

############################
# Local Embedding Service (OPTIONAL)
############################

MODEL_PATH="/aml/mnt/aml/xiaowangge"

############################
# MCP (OPTIONAL)
############################

# Examples/demo reads these; leave blank to disable.
AGENT_MEMORY_MCP_CONFIG=""
AGENT_MEMORY_MCP_SERVERS=""
AGENT_MEMORY_MCP_STDIO=""

# Workspace MCP configured through the portal. HTTP MCP is the tenant
# self-service path; stdio is operator-only and disabled by default.
AGENT_WORKSPACE_MCP_HTTP_ALLOWED_HOSTS="mcp.context7.com,mcp.neon.tech,mcp.supabase.com,supabase.com"
AGENT_WORKSPACE_MCP_HTTP_ALLOW_PRIVATE="0"
AGENT_WORKSPACE_MCP_STDIO_ENABLED="0"
AGENT_WORKSPACE_MCP_STDIO_ALLOWED_COMMANDS=""
AGENT_WORKSPACE_MCP_USE_OPERATOR_FALLBACK="0"

# OPTIONAL (pydantic settings-based MCP config)
MCP_ENABLED="true"
MCP_STDIO_COMMAND=""
MCP_STDIO_ARGS=""
MCP_NAMESPACE="mcp"

############################
# Feature Flags (OPTIONAL)
############################

AGENT_MEMORY_PARALLEL_WORKERS=""
AGENT_MEMORY_DISABLE_JIEBA="0"
AGENT_MEMORY_CONTEXT_BUILDER=""
AGENT_MEMORY_VECTOR_ENABLED="1"
AGENT_MEMORY_VECTOR_BACKEND="pgvector"
AGENT_MEMORY_VECTOR_ASYNC_INDEX="1"
AGENT_MEMORY_VECTOR_INDEX_WORKERS="2"
AGENT_MEMORY_INDEX_STALE_SCAN_MAX_FILES="2000"

############################
# Gateway / Portal Auth (OPTIONAL)
############################

AGENT_GATEWAY_URL="http://127.0.0.1:8080"
AGENT_GATEWAY_API_KEY="<random_gateway_api_key>"
AGENT_GATEWAY_AUTH_TOKEN=""
AGENT_GATEWAY_WORKSPACE_ID=""

# SDK convenience token for customer-owned agents calling the Gateway memory
# proxy. Prefer this over exposing AGENT_MEMORY_SERVICE_API_KEY to applications.
AGENT_MEMORY_GATEWAY_ACCESS_TOKEN=""

AUTH_JWT_SECRET="<random_jwt_signing_secret>"
AUTH_JWT_ALG="HS256"
AUTH_ACCESS_TOKEN_EXPIRES_IN_S="3600"
AUTH_REFRESH_TOKEN_HASH_SECRET="<random_refresh_token_hash_secret>"
AUTH_REFRESH_TOKEN_TTL_S="2592000"

# Encrypts tenant/workspace MCP secrets stored by the portal. Use a distinct
# random value; do not reuse AUTH_JWT_SECRET.
PORTAL_SECRETS_KEY="<random_portal_secret_encryption_key>"

AGENT_CONVERSATION_TTL_SECONDS="86400"
AGENT_GATEWAY_HISTORY_ROUNDS="10"
AGENT_GATEWAY_LLM_STREAMING="1"
AGENT_GATEWAY_STREAM_WITH_TOOLS="0"
AGENT_REFERENCE_RUNTIME_GLOBAL_TOOLS_ENABLED="0"
AGENT_MCP_TOOL_DISCOVERY_CACHE_TTL_S="300"
AGENT_STEP_MODE_ENABLED="0"
MEMORY_CLIENT_POOL_CONNECTIONS="32"
MEMORY_CLIENT_POOL_MAXSIZE="128"
AGENT_OBSERVABILITY_REDIS_ENABLED="1"
AGENT_OBSERVABILITY_MAX_EVENTS="50000"
AGENT_OBSERVABILITY_MAX_METRICS="50000"

FULL_CHAIN_CONTROL_ENABLED="0"
FULL_CHAIN_CONTROL_ALLOWED_TENANTS=""
FULL_CHAIN_CONTROL_ALLOWED_WORKSPACES=""
FULL_CHAIN_CONTROL_ALLOWED_ACTIONS=""

DOTENV_PATH=""

############################
# Tracing IDs (OPTIONAL)
############################

TRACE_ID=""
REQUEST_ID=""

############################
# Logging (OPTIONAL)
############################

LOG_LEVEL="INFO"
LOG_FILE=""


############################
# Preference Confirmation
############################

# Automatic preference extraction is asynchronous. Keep confirmation disabled
# unless a deployment explicitly requires approval.
PREFERENCE_REQUIRE_CONFIRMATION="0"
