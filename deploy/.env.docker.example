# Copy to .env for docker compose and fill secrets.

# REQUIRED for wiring Neo4j container auth.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# REQUIRED for gateway API key.
AGENT_GATEWAY_API_KEY=change-me

# REQUIRED for signing portal access tokens. Use at least 32 random bytes.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# REQUIRED: host folder for ONNX embedding model assets.
# This folder will be mounted into containers at /models.
HOST_MODEL_PATH=/absolute/path/to/onnx-model-folder

# Memory safety defaults
# Require explicit user confirmation before extracted preferences are persisted.
PREFERENCE_REQUIRE_CONFIRMATION=1

# Optional: LLM provider env vars (OpenAI-like example).
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
